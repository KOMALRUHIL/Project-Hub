            df.to_csv(raw_csv_path, index=False, encoding="utf-8-sig")
        
        alt_csv_path = os.path.join(output_folder, "master_derived_dataset.csv")
        df.to_csv(alt_csv_path, index=False, encoding="utf-8-sig")

        # Also copy CSV outputs to SharePoint destination folder if configured
        sp_dest_folder = os.environ.get("SHAREPOINT_FOLDER_PATH", SHAREPOINT_FOLDER_PATH)
        if sp_dest_folder and str(sp_dest_folder).strip():
            try:
                sp_dir = str(sp_dest_folder).strip()
                os.makedirs(sp_dir, exist_ok=True)
                df.to_csv(os.path.join(sp_dir, "claims_complexity_master.csv"), index=False, encoding="utf-8-sig")
                df.to_csv(os.path.join(sp_dir, "master_derived_dataset.csv"), index=False, encoding="utf-8-sig")
                if _MASTER_CACHE.get("df") is not None:
                    _MASTER_CACHE["df"].to_csv(os.path.join(sp_dir, "raw_claims_dataset.csv"), index=False, encoding="utf-8-sig")
                print(f"[SharePoint Sync] Mirrored CSV datasets to: {sp_dir}")
            except Exception as sp_err:
                print("SharePoint folder mirror notice:", sp_err)

        # Automatically export all outputs to Excel in backend output folders
        if export_all_outputs:
            try:
                export_all_outputs(df)
            except Exception as ex_err:
                print("Excel export notice:", ex_err)
        
        cfg = load_sync_config()
        if payload.sharepoint_url is not None:
            cfg["sharepoint_url"] = payload.sharepoint_url.strip()
        cfg["last_synced"] = timestamp_str
        cfg["last_records_count"] = len(df)
        save_sync_config(cfg)
        
        sharepoint_synced = False
        sharepoint_status_msg = "Local master file updated for Power BI Desktop connector."
        
        target_url = payload.sharepoint_url or SHAREPOINT_LINK or cfg.get("sharepoint_url", "")
        if target_url and target_url.startswith(("http://", "https://")):
            try:
                xlsx_backend_file = os.path.join(os.path.dirname(__file__), "backend_output", "clinical_complexity_working_dataset.xlsx")
                if os.path.exists(xlsx_backend_file):
                    with open(xlsx_backend_file, "rb") as f_in:
                        file_bytes = f_in.read()
                    content_type = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                else:
                    file_bytes = df.to_csv(index=False, encoding="utf-8-sig").encode("utf-8-sig")
                    content_type = "text/csv"

                resp = requests.post(
                    target_url, 
                    data=file_bytes, 
                    headers={"Content-Type": content_type, "X-Source": "ClaimOptima-AI-Engine"}, 
                    timeout=15
                )
                if resp.status_code in [200, 201, 202, 204]:
                    sharepoint_synced = True
                    sharepoint_status_msg = f"Successfully synced dataset directly to SharePoint/OneDrive destination."
                else:
                    sharepoint_status_msg = f"SharePoint destination returned HTTP {resp.status_code}. Local file saved."
            except Exception as ex:
                sharepoint_status_msg = f"Local file saved. SharePoint webhook push notice: {str(ex)[:60]}"
                
        return {
            "status": "success",
            "saved_file_path": master_csv_path.replace("\\", "/"),
            "total_records": len(df),
            "total_columns": len(df.columns),
            "timestamp": timestamp_str,
            "sharepoint_url": target_url,
            "sharepoint_synced": sharepoint_synced,
